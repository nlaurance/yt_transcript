# Copy this file to .env and fill in your values.

# Mistral API — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# HTTP read timeout for chat/TTS/STT (ms); default 600000 (10 min)
# MISTRAL_TIMEOUT_MS=600000

# Default output paths (optional). CLI flags override these when set.
# YT_TRANSCRIPT_OUTPUT_DIR=./output
# YT_TRANSCRIPT_NOTE_OUTPUT=~/notes/talks
# YT_TRANSCRIPT_RAW_OUTPUT=~/notes/raw
# YT_TRANSCRIPT_NARRATIVE_OUTPUT=~/notes/narrative
# YT_TRANSCRIPT_AUDIO_OUTPUT=~/notes/audio
# Mistral voice slug or UUID (see audio.voices.list); default by --lang
# YT_TRANSCRIPT_AUDIO_VOICE=fr_marie_neutral
